# Copiar a .env en la raíz. La ruta SQLite relativa parte de backend/.
DATABASE_URL=sqlite:///./agronexa.sqlite3
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NASA_TIMEOUT_SECONDS=20
CACHE_TTL_HOURS=720
RECENT_CACHE_TTL_HOURS=24
MIN_DATA_COVERAGE=0.90
RAIN_DAY_THRESHOLD_MM=1
MIN_RULE_COVERAGE=0.80
LOG_LEVEL=INFO
VITE_API_BASE_URL=
